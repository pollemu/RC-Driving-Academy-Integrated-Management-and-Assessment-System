APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# RC Driving Academy — external integrations (optional)
# The app runs WITHOUT these keys; channels simply log instead of sending.
# Populate and flip *_ENABLED=true once credentials are available.
# ---------------------------------------------------------------------------

# SMS (Semaphore PH) — https://semaphore.co
SMS_DRIVER=semaphore
SMS_ENABLED=false
SMS_FROM=RCDA
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=RCDA

# Email (Laravel mailer) — MAIL_ENABLED controls delivery; MAIL_MAILER=log
# writes to storage/logs/laravel.log instead of sending.
MAIL_ENABLED=true
MAIL_FROM_ADDRESS="no-reply@rcdriving.ph"
MAIL_FROM_NAME="RC Driving Academy"

# Email verification codes for "My Profile" — turn on once an email channel
# (Brevo HTTPS API / SMTP) is live. While off, the Verify Email button
# reports that verification delivery is not available yet.
EMAIL_VERIFICATION_ENABLED=false

# Google Maps (PDC route / venue mapping)
MAPS_DRIVER=google
MAPS_ENABLED=false
GOOGLE_MAPS_API_KEY=

# PayMongo (online payments) — https://dashboard.paymongo.com
# Register webhook (Dashboard -> Developers -> Webhooks -> Add endpoint):
#   https://<your-domain>/api/webhooks/paymongo
# Subscribe to the event: checkout_session.payment.paid
# PAYMONGO_PAYMENT_METHODS: comma-separated methods ENABLED on your account.
#   Leave blank to let PayMongo use your dashboard defaults.
#   Valid: card, gcash, grab_pay, paymaya, billease, dob, qrph
PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
# Signing secret shown by PayMongo for EACH webhook endpoint (NOT the API key).
# PayMongo scopes endpoints by mode (test vs live) and issues a separate secret
# per endpoint, so you may list several, comma-separated: test_secret,live_secret
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_API_URL=https://api.paymongo.com/v1
PAYMONGO_PAYMENT_METHODS=
PAYMONGO_TIMEOUT=20
# Reject webhook signatures older than this many seconds (0 disables).
PAYMONGO_WEBHOOK_TOLERANCE=300

# Grading AI — 'local' runs the bundled PHP learner (no server needed).
# Set to 'external' + a URL only if you host a separate ML model.
NLP_DRIVER=local
NLP_SERVICE_URL=

# Demo payments: allow marking downpayments paid without PayMongo.
# NEVER true in production (also hard-blocked when APP_ENV=production).
ALLOW_FAKE_PAYMENTS=false

VITE_APP_NAME="${APP_NAME}"
